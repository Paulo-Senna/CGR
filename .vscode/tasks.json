{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/glad.c",
                "-I${workspaceFolder}/include",
                "-lglfw",
                "-lGL",
                "-lGLU",
                "-ldl",
                "-lpthread",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila main.cpp + glad.c com g++ (Linux) linkando GLFW e OpenGL do sistema"
        },
        {
            "label": "build snowman",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/snowman.cpp",
                "${workspaceFolder}/src/glad.c",
                "-I${workspaceFolder}/include",
                "-lglfw",
                "-lGL",
                "-lGLU",
                "-ldl",
                "-lpthread",
                "-o",
                "${workspaceFolder}/snowman"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Compila snowman.cpp + glad.c com g++ (Linux) linkando GLFW e OpenGL do sistema"
        },
        {
            "label": "build castle",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/castle.cpp",
                "${workspaceFolder}/src/glad.c",
                "-I${workspaceFolder}/include",
                "-lglfw",
                "-lGL",
                "-lGLU",
                "-ldl",
                "-lpthread",
                "-o",
                "${workspaceFolder}/castle"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Compila castle.cpp + glad.c com g++ (Linux) linkando GLFW e OpenGL do sistema"
        }
    ]
}
